---
import Layoutprojet from "../layouts/Layoutprojet.astro";
import pb, { POCKETBASE_URL } from "../../utils/pb";

interface Photo {
  id: string;
  collectionId: string;
  titre: string;
  legende?: string;
  categorie?: string;
  photo: string;
}

let photos: Photo[] = [];

try {
  const data = await pb.collection("photos").getList(1, 50, {
    sort: "-created",
  });
  photos = data.items;
} catch (e) {
  console.error(e);
}

function getImageUrl(photo: Photo) {
  return `${POCKETBASE_URL}/api/files/${photo.collectionId}/${photo.id}/${photo.photo}`;
}

const paysages = photos.filter((p) => p.categorie === "Paysage");
const urbain = photos.filter((p) => p.categorie === "Urbain");
const humain = photos.filter((p) => p.categorie === "Humain");
---

<Layoutprojet title="Photothèque – Eloïs Henry">
  <!-- INTRO -->
  <section class="py-24 px-6 text-center max-w-4xl mx-auto">
    <h1 class="text-5xl font-bold mb-6">Photothèque</h1>
    <p class="text-xl text-gray-600">
      Une sélection de séries photographiques, pensées comme des récits visuels.
    </p>
  </section>

  <!-- CARROUSEL -->
  {
    [
      { title: "Paysages", photos: paysages },
      { title: "Urbain", photos: urbain },
      { title: "Humain & Détails", photos: humain },
    ].map((section) => (
      <section class="py-20 px-6">
        <div class="max-w-7xl mx-auto">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-3xl font-bold">{section.title}</h2>
            <div class="flex gap-4">
              <button class="carousel-prev">‹</button>
              <button class="carousel-next">›</button>
            </div>
          </div>

          <div class="carousel">
            {section.photos.map((photo) => (
              <div class="carousel-item">
                <img
                  src={getImageUrl(photo)}
                  alt={photo.titre}
                  loading="lazy"
                />
                <div class="caption">
                  <h3>{photo.titre}</h3>
                  {photo.legende && <p>{photo.legende}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))
  }
</Layoutprojet>

<style>
  .carousel {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding-bottom: 1rem;
  }

  .carousel::-webkit-scrollbar {
    display: none;
  }

  .carousel-item {
    min-width: 70vw;
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  @media (min-width: 1024px) {
    .carousel-item {
      min-width: 45vw;
    }
  }

  .carousel-item img {
    width: 100%;
    height: 70vh;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .carousel-item:hover img {
    transform: scale(1.05);
  }

  .caption {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    color: white;
  }

  .caption h3 {
    font-size: 1.5rem;
    font-weight: bold;
  }

  .caption p {
    opacity: 0.85;
    margin-top: 0.5rem;
  }

  .carousel-prev,
  .carousel-next {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: black;
    color: white;
    font-size: 1.5rem;
  }
</style>

<script>
  document.querySelectorAll("section").forEach((section) => {
    const carousel = section.querySelector(".carousel");
    const prev = section.querySelector(".carousel-prev");
    const next = section.querySelector(".carousel-next");

    if (!carousel) return;

    prev?.addEventListener("click", () => {
      carousel.scrollBy({ left: -window.innerWidth * 0.7, behavior: "smooth" });
    });

    next?.addEventListener("click", () => {
      carousel.scrollBy({ left: window.innerWidth * 0.7, behavior: "smooth" });
    });
  });
</script>
